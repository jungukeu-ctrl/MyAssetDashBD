{
  "permissions": {
    "allow": [
      "mcp__Notion__notion-update-page",
      "mcp__Notion__notion-create-pages",
      "mcp__Notion__notion-update-data-source",
      "mcp__Notion__notion-create-database",
      "mcp__Notion__notion-create-comment",
      "mcp__Notion__notion-update-comment",
      "mcp__Notion__notion-move-pages",
      "mcp__Notion__notion-duplicate-page",
      "mcp__Notion__notion-create-view",
      "mcp__Notion__notion-update-view"
    ]
  },
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/set-code-auth.sh",
            "timeout": 5
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/check-code-auth.sh",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/impact-check.sh",
            "timeout": 5,
            "statusMessage": "웹 영향도 분석 중..."
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/sync-plan.sh || true",
            "timeout": 60,
            "statusMessage": "PLAN.md 세션 브랜치 커밋 중..."
          }
        ]
      }
    ]
  }
}
